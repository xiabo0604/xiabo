# ===== 大模型（OpenAI 兼容接口）=====
# DeepSeek 示例：base_url=https://api.deepseek.com/v1  model=deepseek-chat
RAG_LLM_API_KEY=
RAG_LLM_BASE_URL=https://api.openai.com/v1
RAG_LLM_MODEL=gpt-4o-mini

# ===== Embedding =====
# openai=调接口；local=本地哈希向量（离线可用，无需 Key）
RAG_EMBED_BACKEND=
RAG_EMBED_MODEL=text-embedding-3-small

# ===== 检索参数 =====
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_SIM_THRESHOLD=0.5

# ===== 向量库 =====
# 留空=优先 chroma，失败自动退回 numpy；也可强制 chroma / numpy
RAG_STORE=
